+@torch.no_grad()
+def matrix_weight_norms(model: torch.nn.Module, process_group=None) -> dict[str, float]:
+    entries = []
+    for name, parameter in model.named_parameters():
+        if parameter.ndim < 2:
+            continue
+        local = parameter.to_local() if hasattr(parameter, "to_local") else parameter
+        is_sharded = any(p.is_shard() or p.is_partial() for p in getattr(parameter, "placements", ()))
+        entries.append((name, local.float().square().sum(), is_sharded))
+
+    sharded = [value for _, value, is_sharded in entries if is_sharded]
+    if sharded:
+        totals = torch.stack(sharded)
+        dist.all_reduce(totals, group=process_group)
+        totals = iter(totals)
+        entries = [(name, next(totals) if is_sharded else value, is_sharded) for name, value, is_sharded in entries]
+    return {f"weights/frobenius/{name.replace('.', '/')}": value.sqrt().item() for name, value, _ in entries}
+
